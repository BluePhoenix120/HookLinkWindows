# HookLink: the settings baked into the iPhone app (tested on an iPhone 18 Pro Max)
DM_OPMODE=0
# The game thread's real-time computation, measured each 120 frames (1.8.5: it was fixed at 12 ms, too little at 30 fps)
DM_RT_COMP=auto
DM_FPS_HOLD=off
# 1.9: the QoS map, dynamic resolution and the thermal cap are launcher choices now; their defaults come from the build (Model.swift buildEnv), not from this file,
# where the player could not change them
